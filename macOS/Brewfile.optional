# 선택사항 — 기본 설치에 포함되지 않는다.
#
#   brew bundle --file=Brewfile.optional
#
# setup.sh 가 시작할 때 cask 를 하나씩 [y/N] 으로 묻고, 고른 것만 설치한다.
# mas 앱은 자동 설치하지 않고 끝에 "직접 설치"로 안내한다.

cask "chatgpt"

# ── 3D 프린팅 (NoUnique-MacbookAirM1에 설치, 2026-11-17) ─────────
# Fusion: cask는 Client Downloader를 --quiet로 돌려 ~/Applications/Autodesk Fusion.app 에 설치한다.
#   무료 개인용은 별도 앱이 아니라 라이선스 선택이다 → 첫 실행 때 Autodesk 로그인(사람) 후
#   "개인용(비상업적)" 선택. 개인용 등록이 안 된 계정이면 체험판으로 시작하니 Autodesk 웹에서 전환.
# ⚠️ macOS 앱 관리 보호 때문에 brew 설치가 "성공"이라고 나와도 실제론 깨진다 (SETUP-LOG 3D 프린팅 절).
#    설치 전에 사람이: 앱 관리에서 "Install Autodesk Fusion" 켜기 → 설치 프로그램을 open 으로 실행.
cask "autodesk-fusion"
# Bambu Studio: 첫 실행 마법사(지역/프린터/노즐) + Bambu 계정 로그인(사람).
#   로컬 네트워크 요청은 "허용" — LAN으로 프린터를 찾고 출력하는 데 필요한 예외.
cask "bambu-studio"

# ── KakaoTalk ───────────────────────────────────────────────────
# ⚠️ Homebrew 캐스크가 없다 (App Store 전용 배포).
#    mas 로 다루지만 App Store 로그인과 Apple ID 연결이 필요해
#    무인 설치가 되지 않는다. 아래 중 하나로 설치할 것:
#
#      brew bundle --file=Brewfile.optional     (App Store 로그인 상태에서)
#      또는 App Store 앱에서 직접 검색해 설치
#
#    mas 7.x 는 설치 시 root 권한을 요구하는데, sudo 로 실행하면
#    원래 사용자 uid 를 못 찾아 "Failed to get sudo uid" 로 실패한다.
#    → 자동화를 포기하고 App Store 에서 직접 설치하는 편이 확실하다.
brew "mas"
mas "KakaoTalk", id: 869223134
