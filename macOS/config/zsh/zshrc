# ~/.zshrc — 대화형 셸 설정
# 저장소의 config/zsh/zshrc 를 심볼릭 링크한 것 (scripts/zsh.sh)
#
# ⚠️ 역할 분담
#   ~/.zprofile  로그인 시 1회. PATH 등 환경변수. (brew shellenv가 여기 있다)
#   ~/.zshrc     대화형 셸을 열 때마다. 자동완성·히스토리·별칭·프롬프트.
#   PATH를 여기 넣으면 셸을 열 때마다 중복 append 된다. 넣지 말 것.

# ── 자동완성 ────────────────────────────────────────────────────
# Homebrew formula들이 자동완성 파일을 /opt/homebrew/share/zsh/site-functions 에
# 설치한다(_git _gh _brew _ghostty ...). 하지만 compinit을 부르지 않으면
# 하나도 동작하지 않는다.
#
# FPATH 등록은 ~/.zprofile의 brew shellenv가 해주지만 **그건 로그인 셸에서만** 실행된다.
# 터미널 앱은 로그인 셸로 열리므로 보통 문제없으나, `zsh -i` 같은 비로그인 대화형
# 셸에서는 FPATH가 비어 자동완성이 죽는다. 여기서 한 번 더 보장한다.
# ${fpath[(I)...]} 는 일치하는 마지막 인덱스(없으면 0) → 중복 추가 방지
if [[ -d /opt/homebrew/share/zsh/site-functions ]] \
   && (( ${fpath[(I)/opt/homebrew/share/zsh/site-functions]} == 0 )); then
  fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
fi

autoload -Uz compinit

# compinit은 fpath 전체를 훑어서 느리다(수백 ms). 셸을 열 때마다 내는 비용이라
# .zcompdump가 24시간 이내면 캐시를 그대로 쓴다(-C).
# (#qN.mh+24) = glob 한정자. N:없으면 무시, .:일반파일, mh+24:수정 24시간 초과
#
# ⚠️ -C 는 보안 검사뿐 아니라 **새 자동완성 함수 탐색도 건너뛴다.**
#    새 도구를 설치한 직후 자동완성이 안 잡히면 캐시를 지우고 셸을 다시 열 것:
#       rm -f ~/.zcompdump && exec zsh
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# 대소문자 구분 없이 매칭 (git ch<TAB> → checkout)
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
# 후보를 화살표로 고를 수 있는 메뉴
zstyle ':completion:*' menu select
# 후보에 설명 표시
zstyle ':completion:*' verbose yes
zstyle ':completion:*:descriptions' format '%F{yellow}%d%f'

# ── 히스토리 ────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

setopt EXTENDED_HISTORY       # 실행 시각과 소요 시간까지 기록
setopt SHARE_HISTORY          # 여러 터미널 간 히스토리 실시간 공유
setopt HIST_IGNORE_ALL_DUPS   # 같은 명령은 마지막 것만 남김
setopt HIST_IGNORE_SPACE      # 공백으로 시작하는 명령은 기록하지 않음 (비밀 다룰 때)
setopt HIST_REDUCE_BLANKS     # 불필요한 공백 정리
setopt HIST_VERIFY            # !! 등 확장 시 바로 실행하지 않고 한 번 보여줌

# ── 셸 동작 ─────────────────────────────────────────────────────
setopt AUTO_CD                # 디렉터리 이름만 입력해도 이동
setopt INTERACTIVE_COMMENTS   # 대화형 셸에서도 # 주석 허용
setopt NO_BEEP

